# Copy this file to application-local.properties next to pom.xml.
# Create the nnland database and a SQL Server login in SSMS before starting the app.
spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=nnland;encrypt=true;trustServerCertificate=true
spring.datasource.username=nnland_app
spring.datasource.password=DIEN_MAT_KHAU_SQL_SERVER_CUA_BAN
spring.datasource.driver-class-name=com.microsoft.sqlserver.jdbc.SQLServerDriver
server.port=8081
nnland.base-url=http://localhost:8081

# Email: leave false until SMTP is configured.
nnland.mail.enabled=false
# spring.mail.host=smtp.example.com
# spring.mail.port=587
# spring.mail.username=YOUR_SMTP_USERNAME
# spring.mail.password=YOUR_SMTP_PASSWORD_OR_APP_PASSWORD
# nnland.mail.from=YOUR_VERIFIED_SENDER_ADDRESS
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true

# After initial setup you may disable creation of example inventory/accounts.
# Existing records are never deleted by these switches.
nnland.seed-data=true
nnland.demo-accounts=true

# For a clean installation without demo accounts, set demo-accounts=false and
# configure NNLAND_ADMIN_EMAIL and NNLAND_ADMIN_PASSWORD as environment variables.

# Optional SePay Payment Gateway. Use sandbox only with a test database.
nnland.sepay.gateway.mode=disabled
nnland.sepay.gateway.merchant-id=
nnland.sepay.gateway.checkout-key=
nnland.sepay.gateway.ipn-key=
nnland.sepay.operator-email=
